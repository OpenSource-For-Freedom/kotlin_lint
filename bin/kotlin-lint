#!/usr/bin/env bash
# kotlin-lint: Kotlin lint for Android (ktlint + detekt + Jetpack Compose rules).
#
#   kotlin-lint                 logo + interactive menu (in a terminal), otherwise logo + help
#   kotlin-lint lint [dir]      report problems; exit 1 if any
#   kotlin-lint fix [dir]       auto-format, then report what is left
#   kotlin-lint selftest        prove every scan feature works (writes selftest-report.md)
#   kotlin-lint version | help | menu
#
# Works on Linux, macOS and Windows (Git Bash). Requires: bash, curl, a JDK 17+.
# Colors: on in a terminal; NO_COLOR=1 turns them off, FORCE_COLOR=1 turns them on.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$HERE/../scripts/lib.sh"
LOGO=$ROOT/assets/logo.txt
VERSION=0.1.0

# ---------------------------------------------------------------- colors
if [[ -n ${FORCE_COLOR:-} ]] || { [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-} != dumb ]]; }; then
  GREEN=$'\e[38;5;78m'    # Android green
  PURPLE=$'\e[38;5;99m'   # Kotlin purple
  DIM=$'\e[2m' BOLD=$'\e[1m' RED=$'\e[31m' CYAN=$'\e[36m' RESET=$'\e[0m'
else
  GREEN='' PURPLE='' DIM='' BOLD='' RED='' CYAN='' RESET=''
fi
[[ -n ${NO_COLOR:-} ]] && GREEN='' PURPLE='' DIM='' BOLD='' RED='' CYAN='' RESET=''

# The logo (assets/logo.txt): the robot (left 29 columns) in Android green, the wordmark in
# Kotlin purple, the engines line dimmed and the motto in bold.
logo() {
  local line left right style
  while IFS= read -r line || [[ -n $line ]]; do
    left=${line:0:29} right=${line:29}
    case $right in
      *"ktlint +"*) style=$DIM ;;
      *"Same system"*) style=$BOLD ;;
      *) style=$PURPLE ;;
    esac
    printf '%s%s%s%s%s%s\n' "$GREEN" "$left" "$RESET" "$style" "$right" "$RESET"
  done <"$LOGO"
}

banner() {
  logo
  printf '%s  v%s%s\n\n' "$DIM" "$VERSION" "$RESET"
}

usage() {
  cat <<EOF
${BOLD}Usage:${RESET} kotlin-lint [command] [dir]

  ${GREEN}lint${RESET} [dir]    Check Kotlin files (*.kt, *.kts). Exit 1 if problems are found.
       --bugs     Only likely bugs (detekt potential-bugs, exceptions, coroutines;
                  Compose correctness rules). No formatting. See config/bug-rules.txt.
       --no-baseline  Also show findings recorded in .kotlin-lint-baseline.txt.
  ${GREEN}fix${RESET}  [dir]    Auto-format, then show what still needs a manual fix.
  ${GREEN}baseline${RESET} [dir] Record today's findings; from then on lint reports only new ones.
  ${GREEN}selftest${RESET}      Prove every scan feature works; writes selftest-report.md.
  ${GREEN}version${RESET}       Show the versions of kotlin-lint and its engines.
  ${GREEN}help${RESET}          Show this help.

  With no command, a terminal gets an interactive menu.
  [dir] defaults to the current directory. build/ and generated/ are skipped.

  Defaults: Android Studio style, Jetpack Compose rules, Compose-aware detekt.
  Your project's own .editorconfig wins for any setting it defines, for ktlint
  and for detekt's line length.
EOF
}

version() {
  echo "kotlin-lint $VERSION"
  echo "  ktlint        $KTLINT_VERSION"
  echo "  detekt        $DETEKT_VERSION"
  echo "  compose-rules $COMPOSE_VERSION"
}

# Turn detekt's checkstyle XML into "path:line:col: message [detekt:Rule]".
detekt_findings() {
  local xml=$1 base=$2
  [[ -f $xml ]] || return 0
  awk -v base="$base/" '
    function unescape(s) {
      gsub(/&quot;/, "\"", s); gsub(/&apos;/, "\047", s); gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&amp;/, "\\&", s)
      return s
    }
    function attr(name,   r) {
      if (match($0, name "=\"[^\"]*\"")) { r = substr($0, RSTART + length(name) + 2, RLENGTH - length(name) - 3); return unescape(r) }
      return ""
    }
    /<file name=/ { file = attr("name"); gsub(/\\/, "/", file); if (index(file, base) == 1) file = substr(file, length(base) + 1) }
    /<error / {
      rule = attr("source"); sub(/^detekt\./, "", rule)
      print file ":" attr("line") ":" attr("column") ": " attr("message") " [detekt:" rule "]"
    }
  ' "$xml"
}

BASELINE_FILE=.kotlin-lint-baseline.txt

# collect <dir> <out>: every finding under <dir> as "path:line:col: message [engine:rule]",
# sorted by file and line. Paths are relative to the current directory.
collect() {
  local dir=$1 out=$2 work base
  setup_tools
  work=$(mktemp -d)
  BASE=$PWD
  base=$(native "$PWD"); base=${base//\\//}
  lint_ktlint "$work/ktlint" "$dir"
  lint_detekt "$work/detekt" "$dir"
  {
    sed -E 's/ \(([a-z-]+:[a-z0-9-]+)\)$/ [\1]/' "$work/ktlint"
    detekt_findings "$work/detekt.xml" "$base"
  } | sed 's|^\./||' | LC_ALL=C sort -t: -k1,1 -k2,2n -k3,3n >"$out"
  rm -rf "$work"
}

# Baseline entries are "path<TAB>rule<TAB>message": no line numbers, so editing code above a
# known finding does not bring it back. Each entry hides one matching finding.
# One awk parser for both writing and matching, so they always agree on the key.
FINDING_KEY_AWK='
  function finding_key(line,   path, rest) {
    if (!match(line, /^[^:]+:[0-9]+:[0-9]+: /)) return ""
    path = substr(line, 1, index(line, ":") - 1)
    rest = substr(line, RLENGTH + 1)
    if (!match(rest, / \[[^]]+\]$/)) return ""
    return path "\t" substr(rest, RSTART + 2, RLENGTH - 3) "\t" substr(rest, 1, RSTART - 1)
  }'
baseline_entries() {
  awk "$FINDING_KEY_AWK"' { k = finding_key($0); if (k != "") print k }'
}

# hide_baselined <findings> <baseline> <out>: findings not covered by the baseline.
hide_baselined() {
  awk -F'\t' "$FINDING_KEY_AWK"'
    NR == FNR { sub(/\r$/, ""); if ($0 !~ /^#/ && $0 != "") seen[$0]++; next }
    { k = finding_key($0); if (k != "" && seen[k] > 0) { seen[k]--; next } print }' "$2" "$1" >"$3"
}

# rule_summary <findings>: one line per rule, most frequent first.
rule_summary() {
  local total rules shown=15
  total=$(wc -l <"$1" | tr -d ' ')
  [[ $total -eq 0 ]] && return 0
  sed -nE 's/.* \[([^]]+)\]$/\1/p' "$1" | LC_ALL=C sort | uniq -c | LC_ALL=C sort -k1,1nr -k2,2 >"$1.rules"
  rules=$(wc -l <"$1.rules" | tr -d ' ')
  echo
  echo "${BOLD}By rule${RESET} ${DIM}($rules rule(s); likely bugs marked *)${RESET}"
  head -n "$shown" "$1.rules" | while read -r n rule; do
    case $rule in standard:*) engine=ktlint ;; compose:*) engine=compose-rules ;; *) engine=detekt ;; esac
    mark=" "; grep -qxF "$rule" "$BUGS_LIST" && mark="${RED}*${RESET}"
    printf '  %7s %s %-14s %s\n' "$n" "$mark" "$engine" "$rule"
  done
  if [[ $rules -gt $shown ]]; then
    printf '  %7s   %s\n' "$(tail -n +$((shown + 1)) "$1.rules" | awk '{ s += $1 } END { print s }')" \
      "${DIM}in $((rules - shown)) more rule(s)${RESET}"
  fi
}

# lint [--bugs] [--no-baseline] [dir]: print findings and a summary; return 1 if any are left.
lint() {
  local dir=. bugs='' use_baseline=1 work count hidden=0 bugcount
  while [[ $# -gt 0 ]]; do
    case $1 in
      --bugs) bugs=1 ;;
      --no-baseline) use_baseline='' ;;
      -*) echo "${RED}unknown option: $1${RESET}" >&2; return 2 ;;
      *) dir=$1 ;;
    esac
    shift
  done
  [[ -d $dir ]] || { echo "${RED}not a directory: $dir${RESET}" >&2; return 2; }
  dir=${dir%/}
  work=$(mktemp -d)
  echo "${DIM}Linting $dir ...${RESET}" >&2
  collect "$dir" "$work/all"
  BUGS_LIST=$work/bug-rules
  bug_rules >"$BUGS_LIST"

  if [[ -n $use_baseline && -f $BASELINE_FILE ]]; then
    hide_baselined "$work/all" "$BASELINE_FILE" "$work/new"
    hidden=$(( $(wc -l <"$work/all") - $(wc -l <"$work/new") ))
    mv "$work/new" "$work/all"
  fi
  if [[ -n $bugs ]]; then
    awk 'NR == FNR { bug["[" $0 "]"] = 1; next } { n = split($0, f, " "); if (f[n] in bug) print }' \
      "$BUGS_LIST" "$work/all" >"$work/bugs"
    mv "$work/bugs" "$work/all"
  fi

  sed -E \
    -e "s/^([^:]+:[0-9]+:[0-9]+:)/${CYAN//\[/\\[}\1${RESET//\[/\\[}/" \
    -e "s/ (\[[^]]+\])$/ ${DIM//\[/\\[}\1${RESET//\[/\\[}/" "$work/all"
  rule_summary "$work/all"

  count=$(wc -l <"$work/all" | tr -d ' ')
  bugcount=$(awk 'NR == FNR { bug["[" $0 "]"] = 1; next } { n = split($0, f, " "); if (f[n] in bug) c++ } END { print c + 0 }' "$BUGS_LIST" "$work/all")
  rm -rf "$work"
  echo
  local scope="problem(s)"; [[ -n $bugs ]] && scope="likely bug(s)"
  local note=""; [[ $hidden -gt 0 ]] && note=" ${DIM}($hidden known finding(s) hidden by $BASELINE_FILE)${RESET}"
  if [[ $count -eq 0 ]]; then
    echo "${GREEN}${BOLD}No $( [[ -n $bugs ]] && echo 'likely bugs' || echo problems ) found.${RESET}$note"
    return 0
  fi
  if [[ -n $bugs ]]; then
    echo "${RED}${BOLD}$count likely bug(s)${RESET}$note"
  else
    echo "${RED}${BOLD}$count problem(s)${RESET}, ${BOLD}$bugcount likely bug(s)${RESET} ${DIM}(see them alone: kotlin-lint lint --bugs $dir)${RESET}$note"
    if [[ -n ${FIXED:-} ]]; then echo "${DIM}Formatting is fixed; these need a manual fix.${RESET}"
    else echo "${DIM}Run 'kotlin-lint fix $dir' to auto-format; the rest need a manual fix.${RESET}"; fi
  fi
  return 1
}

# baseline [dir]: record today's findings so lint reports only new ones from now on.
baseline() {
  local dir=${1:-.} work count
  [[ -d $dir ]] || { echo "${RED}not a directory: $dir${RESET}" >&2; return 2; }
  dir=${dir%/}
  work=$(mktemp -d)
  echo "${DIM}Recording findings in $dir ...${RESET}" >&2
  collect "$dir" "$work/all"
  {
    echo "# kotlin-lint baseline: known findings that 'kotlin-lint lint' does not report."
    echo "# One per line: path<TAB>rule<TAB>message. No line numbers, so edits above a finding"
    echo "# do not bring it back. Fixed findings can be deleted, or rerun 'kotlin-lint baseline'."
    baseline_entries <"$work/all" | LC_ALL=C sort
  } >"$BASELINE_FILE"
  count=$(wc -l <"$work/all" | tr -d ' ')
  rm -rf "$work"
  echo "${GREEN}${BOLD}Baseline written:${RESET} $count finding(s) in $BASELINE_FILE"
  echo "${DIM}From now on 'kotlin-lint lint' reports only new findings. Commit the file.${RESET}"
}

fix() {
  local dir=${1:-.}
  [[ -d $dir ]] || { echo "${RED}not a directory: $dir${RESET}" >&2; return 2; }
  setup_tools
  BASE=$PWD
  echo "${DIM}Formatting ${dir%/} ...${RESET}" >&2
  format_ktlint "${dir%/}"
  FIXED=1 lint "$dir"
}

selftest() {
  "$ROOT/scripts/selftest.sh"
}

menu() {
  local choice dir
  banner
  cat <<EOF
  ${BOLD}What do you want to do?${RESET}

    ${GREEN}1${RESET}) Lint       check Kotlin files for problems
    ${GREEN}2${RESET}) Fix        auto-format Kotlin files
    ${GREEN}3${RESET}) Self-test  prove every scan feature works
    ${GREEN}4${RESET}) Version    show engine versions
    ${GREEN}5${RESET}) Help       show all commands
    ${GREEN}q${RESET}) Quit

EOF
  read -r -p "  Choose [1-5, q]: " choice || choice=q
  case $choice in
    1 | 2)
      read -r -p "  Folder to check [.]: " dir || dir=.
      echo
      if [[ $choice == 1 ]]; then lint "${dir:-.}"; else fix "${dir:-.}"; fi
      ;;
    3) echo; selftest ;;
    4) echo; version ;;
    5) echo; usage ;;
    q | Q | "") echo "  Bye!" ;;
    *) echo "${RED}  Unknown choice: $choice${RESET}" >&2; return 2 ;;
  esac
}

case ${1:-} in
  "")
    if [[ -t 0 && -t 1 ]]; then menu
    else banner; usage; fi
    ;;
  menu) menu ;;
  lint) shift; lint "$@" ;;
  baseline) baseline "${2:-.}" ;;
  fix) fix "${2:-.}" ;;
  selftest) selftest ;;
  version | --version | -v) version ;;
  help | --help | -h) banner; usage ;;
  logo) logo ;;
  *) echo "${RED}unknown command: $1${RESET}" >&2; usage >&2; exit 2 ;;
esac
